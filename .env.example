NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
TRUST_PROXY=false

# Runtime role: subject to row-level security. Used for every tenant-scoped request.
DATABASE_URL=postgres://saas_app:saas_app_dev@localhost:5432/tenantly
# Privileged role (BYPASSRLS): used only by auth flows and the Stripe webhook.
SYSTEM_DATABASE_URL=postgres://saas_system:saas_system_dev@localhost:5432/tenantly
# Table owner / superuser: used only by `npm run migrate`.
MIGRATION_DATABASE_URL=postgres://postgres:postgres@localhost:5432/tenantly

JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-characters
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_PRICE_PRO=price_replace_me

# Optional: enables "Sign in with Google" (OAuth2 authorization code + PKCE)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
